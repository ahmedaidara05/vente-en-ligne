rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        (userDoc().role == 'superadmin' || userDoc().role == 'admin');
    }
    
    function isStaff() {
      return isSignedIn() && 
        (userDoc().role == 'superadmin' || 
         userDoc().role == 'admin' || 
         userDoc().role == 'manager' || 
         userDoc().role == 'stock' || 
         userDoc().role == 'orders');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      // Create: only own doc, and role must be customer (or absent)
      allow create: if isSignedIn() && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer');
      // Update: owner can update non-role fields; only admin can change role
      allow update: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.published == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if resource.data.active == true || isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isStaff() || 
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isStaff() || 
        (isSignedIn() && resource.data.userId == request.auth.uid && 
         resource.data.status == 'pending' && 
         request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    match /inventoryMovements/{movId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isStaff() || isSignedIn();
      allow update: if isOwner(resource.data.userId) || isStaff();
    }

    match /adminRoles/{roleId} {
      allow read, write: if isAdmin();
    }
    
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
    }
  }
}
